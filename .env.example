# App/auth
AUTH_SECRET=your-32-byte-base64-auth-secret-here
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret
OWNER_GITHUB_ID=your-github-username-or-numeric-id
NEXT_PUBLIC_TRACEVAULT_URL=http://localhost:3001
NEXT_PUBLIC_AGENTLEDGER_URL=http://localhost:3002

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evidencekit

# Object storage (Production S3/R2)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=evidencekit-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Evidence signing (Optional Ed25519)
EVIDENCE_SIGNING_PRIVATE_KEY=
EVIDENCE_SIGNING_KEY_ID=
EVIDENCE_VERIFY_PUBLIC_KEY=

# Limits (Bytes)
MAX_UPLOAD_COMPRESSED_BYTES=20971520
MAX_UPLOAD_EXPANDED_BYTES=104857600
MAX_ARCHIVE_ENTRIES=200
MAX_EVENT_PAYLOAD_BYTES=65536

# Demo / Public Judge Mode (read-only without owner auth)
DEMO_MODE=true

